# CogniDiff environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# Anthropic Claude API — Phase 4, used only for plain-language summaries.
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# JWT signing secret — Phase 6. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Backup encryption key — Phase 6. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_KEY=your_backup_key_here

# Deployment profile: development | production
ENV=development

# Comma-separated CORS allowlist. Add your extension origin once you know its ID.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Emergency switch — returns 503 from data endpoints, audit log stays writable.
MAINTENANCE_MODE=false
